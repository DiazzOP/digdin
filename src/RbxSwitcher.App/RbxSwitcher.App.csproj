<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WinForms without the WindowsDesktop SDK: the UI is built in code (no designer files), so this
    project also compiles on Linux/macOS CI with EnableWindowsTargeting. It runs only on Windows.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>RbxSwitcher.App</RootNamespace>
    <AssemblyName>RbxSwitcher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- The WPF half of the WebView2 package is not used; silence its WindowsBase version warning. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <ProjectReference Include="../RbxSwitcher.Core/RbxSwitcher.Core.csproj" />
    <EmbeddedResource Include="Browser/TradeAssist.js" LogicalName="RbxSwitcher.TradeAssist.js" />
    <Using Include="System.Drawing" />
    <Using Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
